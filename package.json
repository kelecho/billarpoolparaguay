{
  "name": "pool-paraguay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && tsc -p worker && vite build",
    "build:remote": "tsc -b && tsc -p worker && vite build --mode remote --outDir dist-remote",
    "preview": "vite preview --host 0.0.0.0",
    "dev:remote": "npm run build:remote && node server.mjs",
    "deploy": "npm run build:remote && wrangler d1 migrations apply pool-paraguay --remote && wrangler deploy",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:remote": "playwright test -c playwright.remote.config.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@fontsource/changa-one": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260919.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  }
}
