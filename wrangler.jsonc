{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pool-paraguay",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist-remote",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "pool-paraguay-photos" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pool-paraguay",
      "database_id": "7402eea8-8668-4fc9-8724-f4292de1f642",
      "migrations_dir": "migrations"
    }
  ]
}
